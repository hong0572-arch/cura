{
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 0 * * *"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/en",
      "destination": "/en.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/en/about",
      "destination": "/en/about.html"
    },
    {
      "source": "/book-vehicle",
      "destination": "/book-vehicle.html"
    },
    {
      "source": "/en/book-vehicle",
      "destination": "/en/book-vehicle.html"
    },
    {
      "source": "/blog",
      "destination": "/blog.html"
    },
    {
      "source": "/en/blog",
      "destination": "/en/blog.html"
    },
    {
      "source": "/business",
      "destination": "/business.html"
    },
    {
      "source": "/en/business",
      "destination": "/en/business.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/en/terms",
      "destination": "/en/terms.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/en/privacy",
      "destination": "/en/privacy.html"
    },
    {
      "source": "/private-journeys",
      "destination": "/private-journeys.html"
    },
    {
      "source": "/en/private-journeys",
      "destination": "/en/private-journeys.html"
    },
    {
      "source": "/travel-from",
      "destination": "/travel-from.html"
    },
    {
      "source": "/en/travel-from",
      "destination": "/en/travel-from.html"
    },
    {
      "source": "/travel-from/united-states",
      "destination": "/travel-from/united-states.html"
    },
    {
      "source": "/en/travel-from/united-states",
      "destination": "/en/travel-from/united-states.html"
    },
    {
      "source": "/travel-from/india",
      "destination": "/travel-from/india.html"
    },
    {
      "source": "/en/travel-from/india",
      "destination": "/en/travel-from/india.html"
    },
    {
      "source": "/travel-from/middle-east",
      "destination": "/travel-from/middle-east.html"
    },
    {
      "source": "/en/travel-from/middle-east",
      "destination": "/en/travel-from/middle-east.html"
    },
    {
      "source": "/travel-from/germany",
      "destination": "/travel-from/germany.html"
    },
    {
      "source": "/en/travel-from/germany",
      "destination": "/en/travel-from/germany.html"
    },
    {
      "source": "/travel-from/united-kingdom",
      "destination": "/travel-from/united-kingdom.html"
    },
    {
      "source": "/en/travel-from/united-kingdom",
      "destination": "/en/travel-from/united-kingdom.html"
    },
    {
      "source": "/travel-from/singapore",
      "destination": "/travel-from/singapore.html"
    },
    {
      "source": "/en/travel-from/singapore",
      "destination": "/en/travel-from/singapore.html"
    },
    {
      "source": "/sitemap-blog.xml",
      "destination": "/api/sitemap-blog"
    },
    {
      "source": "/blog/:postId",
      "destination": "/api/blog-page/:postId"
    },
    {
      "source": "/en/blog/:postId",
      "destination": "/api/blog-page/:postId?lang=en"
    },
    {
      "source": "/(.*)",
      "destination": "/spa.html"
    }
  ]
}
